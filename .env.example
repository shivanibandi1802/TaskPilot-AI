# ==============================================================================
# TaskPilot AI — Optional Cloud Persistence Environment Variables
# ==============================================================================
# TaskPilot AI operates 100% OFFLINE with LocalStorage by default. Zero setup needed.
# If you wish to enable persistent cloud synchronization across devices, create a
# free Supabase project at https://supabase.com and provide the credentials below.
#
# IMPORTANT SECURITY NOTE:
# Never enter or commit your service_role key.
# ONLY use your project's PUBLIC client Anon Key (SUPABASE_ANON_KEY).
# ==============================================================================

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key
